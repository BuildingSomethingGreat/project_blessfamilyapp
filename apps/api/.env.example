# ---- Bless-A-Family API ----
PORT=8787
NODE_ENV=development
WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# memory (local JSON file, seeded with demo households) | airtable
STORE=memory
DATA_DIR=./data
SEED_DEMO=true

# Airtable (STORE=airtable). Create a personal access token with data.records:read/write + schema.bases:read
# scoped to the base below. https://airtable.com/create/tokens
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=apphUgu1q4Z7ya3Tw

# Admin sign-in (magic link). Comma-separated allowlist.
ADMIN_EMAILS=admin@example.com
SESSION_SECRET=change-me-to-a-long-random-string

# Email via Resend (https://resend.com). With no key, emails print to the server log and the
# login pages show the sign-in link directly (local dev only).
RESEND_API_KEY=
# Sender on a domain verified in Resend. A bare address is shown as "Bless This Family <...>".
RESEND_EMAIL=bless@thekonnection.org
# Optional. Replies go here; defaults to the contact email in Admin → Settings.
EMAIL_REPLY_TO=

# Claude: admin assistant. Leave empty to run without the agent.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
WRITER_MODEL=claude-opus-5-5

# Follow-up engine
FOLLOWUP_ENABLED=true
FOLLOWUP_TICK_MINUTES=10
FOLLOWUP_CONFIRM_HOURS=48
FOLLOWUP_FLAG_AFTER=2
