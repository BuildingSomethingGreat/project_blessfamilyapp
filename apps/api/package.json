{
  "name": "@bless/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server.mjs --external:@anthropic-ai/sdk --external:hono --external:@hono/node-server --external:zod --log-level=warning",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "seed:airtable": "tsx src/scripts/seed-airtable.ts",
    "build:netlify": "esbuild api=src/netlify.ts followups=src/netlify-followups.ts --bundle --platform=node --target=node22 --format=esm --outdir=../web/netlify/functions --out-extension:.js=.mjs --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\" --log-level=warning"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@bless/shared": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}